# ==========================================
# Dream Viewer - Environment Configuration
# ==========================================

# Server & Ports
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL=postgresql://dreamuser:dreampassword@localhost:5432/dream_viewer?schema=public
POSTGRES_USER=dreamuser
POSTGRES_PASSWORD=dreampassword
POSTGRES_DB=dream_viewer
POSTGRES_PORT=5432

# Redis & Job Queues
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# AI Video & Image Providers
# Supported Options: comfy | mock
# Note: Unknown provider values will fail on startup (no silent fallback).
DREAM_PROVIDER=comfy
COMFYUI_HOST=http://127.0.0.1:8188

# Cloudflare R2 / S3 Storage (Optional for local development)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=dream-viewer-assets
R2_PUBLIC_URL=https://assets.dreamviewer.app

# Content Moderation & AI Director
# Options: mock | openai | perspective
MODERATION_PROVIDER=mock
OPENAI_API_KEY=
GEMINI_API_KEY=
