# ==========================================
# Dream Viewer - Environment Configuration
# ==========================================

# Server & Ports
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL=postgresql://dreamuser:dreampassword@localhost:5432/dream_viewer?schema=public
POSTGRES_USER=dreamuser
POSTGRES_PASSWORD=dreampassword
POSTGRES_DB=dream_viewer
POSTGRES_PORT=5432

# Redis & Job Queues
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# AI Video & Image Providers
# Supported Options: comfy | mock
# Note: Unknown provider values will fail on startup (no silent fallback).
DREAM_PROVIDER=comfy
COMFYUI_HOST=http://127.0.0.1:8188

# Wan 2.2 GPU Generation Parameters (RTX 5070 8GB VRAM Optimized)
WAN_VIDEO_FRAMES=49
WAN_VIDEO_TIMEOUT_MS=900000
WAN_EASYCACHE_THRESHOLD=0
WAN_STEPS=20
WAN_KEYFRAME_STEPS=20
WAN_WIDTH=832
WAN_HEIGHT=480
WAN_FPS=24
WAN_SHIFT=8.0
WAN_CFG=5.0

# Keyframe Image Generation Backend (SDXL recommended for 1344x768 sharp detail)
# Supported Options: sdxl | wan (unknown values fail explicitly without fallback)
KEYFRAME_BACKEND=sdxl
KEYFRAME_CHECKPOINT=Juggernaut-XL_v9_RunDiffusionPhoto_v2.safetensors
KEYFRAME_WIDTH=1344
KEYFRAME_HEIGHT=768
KEYFRAME_STEPS=25
KEYFRAME_CFG=6.5
KEYFRAME_SAMPLER=dpmpp_2m
KEYFRAME_SCHEDULER=karras
KEYFRAME_TIMEOUT_MS=180000

# Cloudflare R2 / S3 Storage (Optional for local development)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=dream-viewer-assets
R2_PUBLIC_URL=https://assets.dreamviewer.app

# Content Moderation
# Options: mock | openai | perspective
MODERATION_PROVIDER=mock
OPENAI_API_KEY=
GEMINI_API_KEY=

# Multi-Scene Video Transition (FFmpeg crossfade duration in seconds)
WAN_TRANSITION_SECONDS=0.3

# ==========================================
# Dream Architect LLM (Multi-Scene Storyboarding)
# Options: openai_compat | mock
# VRAM Note for 8GB GPUs: Run LM Studio with GPU offload = 0 (CPU mode) to keep all 8GB VRAM free for Wan 2.2!
# ==========================================
ARCHITECT_PROVIDER=mock
ARCHITECT_BASE_URL=http://127.0.0.1:1234/v1
ARCHITECT_MODEL=qwen2.5-3b-instruct
ARCHITECT_API_KEY=lm-studio
ARCHITECT_TIMEOUT_MS=60000

# ==========================================
# Video Generation Queue Architecture
# Options: memory | bullmq
# Note: "bullmq" requires an active Redis server (e.g. docker run -p 6379:6379 redis or Memurai).
# If bullmq is chosen and Redis is unreachable, the server will strictly fail at startup.
# ==========================================
QUEUE_DRIVER=memory
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
